# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# API Credentials (SERVER SIDE ONLY - NEVER EXPOSE TO FRONTEND)
# Get your API keys from the respective services and add them here
FORTYGUARD_API_KEY=your_fortyguard_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Optional comma-separated pool. Requests rotate to the next key on HTTP 429.
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# FortyGuard Configurations
FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1
FORTYGUARD_POLL_INTERVAL_SEC=2.0
FORTYGUARD_MAX_POLL_ATTEMPTS=15

# Cache Settings
CACHE_DIR=./data/cache
CACHE_TTL_SECONDS=86400
